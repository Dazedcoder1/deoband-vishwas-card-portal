# =====================================================================
#  Deoband Vishwas Card — ONE shared environment file for backend + frontend
#  Copy this file to ".env" in the same folder and fill in real values.
#  - Backend reads every variable (via dotenv, path ../.env)
#  - Frontend (Vite) reads ONLY variables that start with VITE_  → never
#    put secrets in a VITE_ variable, they end up in the browser bundle.
# =====================================================================

# ---------- General ----------
NODE_ENV=development

# ---------- Backend API ----------
PORT=5000
# Where the frontend runs (used for CORS and for the QR / SMS verify links).
# Comma-separate multiple origins if needed.
CLIENT_URL=http://localhost:5173
# Long random string. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-with-a-long-random-string
JWT_EXPIRES_IN=7d

# ---------- Database: Neon PostgreSQL ----------
# Neon dashboard → your project → Connect → copy the connection string (pooled is fine).
# Tables are created automatically when the backend starts (or run: npm run db:migrate).
DATABASE_URL=postgresql://USER:PASSWORD@YOUR-ENDPOINT-pooler.REGION.aws.neon.tech/neondb?sslmode=require&channel_binding=require
DATABASE_POOL_MAX=10

# First admin account — created/updated automatically on server start
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-this-password
ADMIN_NAME=Dr. Anoop Verma

# OTP login. DEV MODE shows the OTP on screen + in the API response (handy while testing).
# MUST be false in production — set it to false once MSG91 is working.
OTP_DEV_MODE=true
OTP_TTL_SECONDS=300
OTP_RESEND_SECONDS=45

# Card settings
CARD_ID_PREFIX=DBD
CARD_VALIDITY_YEARS=2
CONSTITUENCY_NAME=Deoband (04)

# ---------- File storage ----------
# auto  = use the bucket when endpoint/keys/bucket below are filled, otherwise local disk
# r2    = always the S3/R2 bucket     local = always ./backend/uploads
STORAGE_DRIVER=auto
LOCAL_UPLOAD_DIR=./uploads
# Folder inside the bucket for uploaded files (photos go to <prefix>/photos/…)
STORAGE_PREFIX=uploads

# ---------- Cloudflare R2 / any S3-compatible bucket ----------
# Cloudflare dashboard → R2 → Manage R2 API Tokens → Create API token
# (The standard AWS_ENDPOINT_URL / AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY /
#  AWS_S3_BUCKET_NAME / AWS_REGION names also work if your provider gives you those.)
R2_ENDPOINT=https://<ACCOUNT_ID>.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=assets
R2_REGION=auto
S3_FORCE_PATH_STYLE=true
# Optional: public bucket URL or custom domain (e.g. https://cdn.example.com).
# Leave empty to keep the bucket private and use short-lived signed URLs.
R2_PUBLIC_URL=
# Optional: Cloudflare account API token (for wrangler / deployments; not used by the app itself)
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=

# ---------- SMS: MSG91 (OTP login + e-card links) ----------
# "msg91" = send real SMS through MSG91      "console" = just print messages in the backend terminal
SMS_PROVIDER=console
# MSG91 dashboard → Authkey (top-right profile menu → Authkey)
MSG91_AUTH_KEY=
# MSG91 → SendOTP → create an OTP template containing ##OTP## (DLT-approved) → copy its Template ID
MSG91_OTP_TEMPLATE_ID=
# Optional — MSG91 → SMS → Templates (Flow). Leave empty to skip these messages.
#   e-card link template, variables: ##var1## = name, ##var2## = card ID, ##var3## = verify link
MSG91_ECARD_TEMPLATE_ID=
#   "find my card" template, variables: ##var1## = card number(s)
MSG91_CARDID_TEMPLATE_ID=

# ---------- Frontend (public — exposed to the browser) ----------
# Dev: keep "/api" (Vite proxies it to the backend).
# Prod: full backend URL, e.g. https://api.deobandvishwas.org/api
VITE_API_URL=/api
VITE_API_PROXY_TARGET=http://localhost:5000
VITE_HELPLINE=1800-120-DEOBAND
VITE_SUPPORT_EMAIL=help@deobandvishwas.org
